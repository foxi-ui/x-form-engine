{
  "name": "@x-form-engine/components",
  "version": "0.0.1-beta.1",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./mobile": {
      "types": "./mobile.ts",
      "default": "./mobile.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts mobile.ts --format esm,cjs --dts --sourcemap --clean --out-dir dist",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "registry": "https://npm.bugduo.com/",
    "main": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/src/index.d.ts",
          "default": "./dist/src/index.js"
        },
        "require": {
          "types": "./dist/src/index.d.cts",
          "default": "./dist/src/index.cjs"
        }
      },
      "./mobile": {
        "types": "./dist/mobile.d.ts",
        "import": "./dist/mobile.js",
        "require": "./dist/mobile.cjs"
      }
    }
  },
  "dependencies": {
    "@ant-design/icons": "4.8.3",
    "@formily/antd": "2.3.7",
    "@formily/react": "2.3.7",
    "@x-form-engine/types": "workspace:*",
    "antd": "4.22.8",
    "antd-mobile": "5.43.0",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-is": "17.0.2"
  },
  "devDependencies": {
    "@formily/core": "2.3.7",
    "@testing-library/jest-dom": "5.16.5",
    "@testing-library/react": "12.1.5",
    "@types/react": "17.0.0",
    "@types/react-dom": "17.0.0",
    "@types/testing-library__jest-dom": "5.14.9",
    "@x-form-engine/core": "workspace:*",
    "@x-form-engine/renderer": "workspace:*",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
