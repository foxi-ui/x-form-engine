{
  "name": "@x-form-engine/sdk",
  "version": "0.0.1-beta",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --out-dir dist",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "registry": "https://npm.bugduo.com/",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  },
  "dependencies": {
    "@x-form-engine/adapters": "workspace:*",
    "@x-form-engine/core": "workspace:*",
    "@x-form-engine/renderer": "workspace:*",
    "@x-form-engine/services": "workspace:*",
    "@x-form-engine/types": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "12.1.5",
    "@types/react": "17.0.0",
    "@types/react-dom": "17.0.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
